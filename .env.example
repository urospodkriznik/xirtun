# Copy to .env and fill in. All .env* files except this one are gitignored — never
# commit real secrets.
#
# One person (dev): put everything here.
# Several people (the VM): this .env holds the shared defaults, and each person gets a
# .env.<name> — written by `make adduser` — with their own Telegram settings and
# anything else they want different. Theirs overrides this one (see DEPLOY.md).

# --- Telegram (per person on the VM: leave empty here, they live in .env.<name>) ---
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# --- LLM (Gemini to start; a person can override the key in their own file) ---
GEMINI_API_KEY=
LLM_CHEAP_MODEL=gemini-2.5-flash-lite
LLM_STRONG_MODEL=gemini-2.5-pro

# --- Paths & schedule ---
# Ignored on the VM: the xirtun@<name> service sets it to data/<name>/ itself.
DATA_DIR=./data
# Cron schedule for the weekly run check — fires daily at 17:00 and runs if 7 days have passed since the last review.
WEEKLY_CRON=0 17 * * *
# Cron schedule for the morning weight-log reminder. Fires daily but only nudges on the
# morning the weekly review is due, and only if no weight was logged in the last 6 days.
# Keep it earlier in the day than WEEKLY_CRON so the nudge lands before the review runs.
WEIGHT_REMINDER_CRON=0 8 * * *
