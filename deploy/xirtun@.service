# systemd template unit for the xirtun bot — one instance per person, all running the
# same code (ADR-017). Each instance is one long-running process (Telegram long-poll
# + in-process APScheduler weekly job) with its own bot, settings file and data folder.
# The part after the @ is the instance name: xirtun@uros reads .env.uros (layered over
# the shared .env) and keeps its data in data/uros/. See DEPLOY.md for the full setup.
#
# Install once, then add people with `make adduser` (which enables xirtun@<name>):
#   sudo cp deploy/xirtun@.service /etc/systemd/system/xirtun@.service
#   sudo systemctl daemon-reload
#
# Adjust User/paths below if you don't use the `xirtun` deploy user / layout from
# DEPLOY.md. CD restarts every running instance (systemctl restart 'xirtun@*').

[Unit]
Description=xirtun personal nutritionist Telegram bot (%i)
# Long-polling needs outbound network; wait for it before starting.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=xirtun
Group=xirtun
WorkingDirectory=/home/xirtun/xirtun

# Secrets and config live only on the VM, never in git. The app reads this person's
# file itself (config.py, ENV_FILE) rather than systemd's EnvironmentFile, then the
# shared .env beside it for anything the person's file leaves out — except the
# Telegram keys, which must be in the person's own file or the instance won't start.
Environment=ENV_FILE=/home/xirtun/xirtun/.env.%i
# Set here rather than in the .env file so two instances can never end up sharing a
# data folder: a value from systemd wins over the file's.
Environment=DATA_DIR=/home/xirtun/xirtun/data/%i

# uv is installed per-user (~/.local/bin) and is not on systemd's PATH, so call it
# by absolute path. `uv run` resolves the project venv and Python itself.
ExecStart=/home/xirtun/.local/bin/uv run python -m xirtun.main

# Keep the bot up across crashes, restarts, and reboots.
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
